# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/autonomous_ml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=autonomous_ml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlruns

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Agent Configuration
MAX_ITERATIONS=5
MIN_IMPROVEMENT_THRESHOLD=0.01
DEFAULT_TEST_SIZE=0.2
RANDOM_STATE=42

# File Paths
DATASETS_DIR=./datasets
REPORTS_DIR=./reports
MLRUNS_DIR=./mlruns

# Frontend
FRONTEND_URL=http://localhost:5173